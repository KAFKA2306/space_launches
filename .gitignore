# Strict ignore by default
*

# Allow directories structure
!*/

# Allow specific configuration files
!Taskfile.yml
!pyproject.toml
!README.md
!.gitignore

# Allow source code
!src/
!src/**

# Allow specific resource directories (but verify context)
!resources/
!resources/**

# Allow scripts if necessary
!scripts/
!scripts/**

# Allow docs
!docs/
!docs/**
docs/tradenote/

# Allow data READMEs and example data if truly needed, but default block data
!data/
data/*
!data/examples/
!data/examples/**
!data/raw/README.md
!data/**/.gitkeep

# Explicitly exclude common garbage / build artifacts even if they match above (safety net)
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
.venv/
venv/
env/
.env

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
*.ipynb
.ipynb_checkpoints/

# Legacy folder (exclude per user previous patterns, or include if source)
legacy/
